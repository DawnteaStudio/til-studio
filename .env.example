GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
TIL_REPOSITORY_OWNER=DawnteaStudio
TIL_REPOSITORY_NAME=TIL
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local desktop remains the default outside Vercel.
# On another host, set TIL_STUDIO_MODE=hosted explicitly.
TIL_STUDIO_MODE=
# Hosted publication scope. Missing/invalid/empty allows no public folders.
TIL_PUBLIC_ROOTS=["cs","languages","projects","coding-test"]
# GitHub OAuth App for owner sign-in (separate from the repository GitHub App).
AUTH_URL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub account ID of the owner.
TIL_ADMIN_GITHUB_ID=
# Private Vercel Blob store for owner drafts, connected with Vercel OIDC.
BLOB_STORE_ID=
# Optional legacy or external-host authentication alternative.
BLOB_READ_WRITE_TOKEN=
